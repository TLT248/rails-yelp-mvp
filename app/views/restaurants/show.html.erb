
<div class="container d-flex gap-3 m-5">

<div class="card d-flex" style="width: 18rem;">
  <div class="card-body">
    <h3 class="card-title"><%= @restaurant.name %></h3>
    <p class="card-text">Cuisine : <%= @restaurant.category %></p>
  </div>
  <ul class="list-group list-group-flush">
    <li class="list-group-item"><%= @restaurant.phone_number %></li>
    <li class="list-group-item"><%= @restaurant.address %></li>
  </ul>
  <div class="card-body">
    <h5 class="card-title">Reviews</h5>

    <% @restaurant.reviews.each do |review| %>
    <p class="card-text">Rating : <%= review.rating %>/5 - "<%= review.content %>"</p>
    <% end %>

  </div>
  <div class="card-body">
    <a href="/restaurants" class="card-link">Back to list</a>
    <a href="#" class="card-link">Give review</a>
  </div>
</div>

</div>
