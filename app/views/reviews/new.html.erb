<div class="container d-flex gap-3 m-5">

  <%= simple_form_for [@restaurant, @review] do |f| %>
    <%= f.input :rating, collection: [0, 1, 2, 3, 4, 5] %>
    <%= f.input :content %>
    <%= f.submit %>
<% end %>

</div>

<div class="container d-flex gap-3 m-5">
  <%= link_to 'Back to list', restaurants_path %>
</div>
