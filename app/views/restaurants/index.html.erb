
<div class="container d-flex gap-3 m-5 row">

<% @restaurants.each do |restaurant| %>

<div class="card d-flex col-3">
  <div class="card-body">
    <h5 class="card-title"><%= restaurant.name %></h5>
    <p class="card-text">Cuisine : <%= restaurant.category %></p>
  </div>
  <ul class="list-group list-group-flush">
    <li class="list-group-item"><%= restaurant.phone_number %></li>
    <li class="list-group-item"><%= restaurant.address %></li>
  </ul>
  <div class="card-body">
    <a href="restaurants/<%= restaurant.id %>" class="card-link">See details</a>
    <%= link_to 'Give review', new_restaurant_review_path(restaurant) %>
  </div>
</div>

<% end %>

</div>

<div class="container d-flex gap-3 m-5">
  <a href="restaurants/new" class="btn btn-primary">+ Add a restaurant</a>
</div>
